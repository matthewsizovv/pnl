# Master key for AES-GCM encryption of private keys (hex, 64 chars)
# Generate: openssl rand -hex 32
MASTER_KEY=

# Optional: Alchemy API key
ALCHEMY_KEY=

# Optional: Tenderly access key
TENDERLY_KEY=

# Optional: 1inch API key
ONEINCH_KEY=

# Optional: Override log level (trace|debug|info|warn|error)
LOG_LEVEL=info
